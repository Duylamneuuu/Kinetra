{
  "name": "@kinetra/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "assemble": "node scripts/assemble.mjs",
    "build": "pnpm build:web && pnpm build:electron && pnpm assemble",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package:win": "pnpm build && node scripts/package-win.mjs",
    "package:linux": "pnpm build && node scripts/package-linux.mjs",
    "smoke:win": "node scripts/smoke-win.mjs",
    "smoke:linux": "node scripts/smoke-linux.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke:linux:packaged": "node scripts/smoke-linux-packaged.mjs"
  },
  "dependencies": {
    "@kinetra/audio": "workspace:*",
    "@kinetra/core": "workspace:*",
    "@kinetra/input": "workspace:*",
    "@kinetra/navigation-recast": "workspace:*",
    "@kinetra/physics-rapier": "workspace:*",
    "@kinetra/project-model": "workspace:*",
    "@kinetra/reference-game": "workspace:*",
    "@kinetra/renderer-three": "workspace:*",
    "@kinetra/save-state": "workspace:*",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@kinetra/verification": "workspace:*",
    "@types/three": "0.180.0",
    "electron": "38.0.0",
    "vite": "^7.1.0"
  }
}
