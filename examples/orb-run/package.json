{
  "name": "@kinetra/example-orb-run",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Orb Run: a small dogfood sample game authored entirely through Kinetra's MCP tools and command bus.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./game-module": {
      "types": "./dist/src/game-module.d.ts",
      "default": "./dist/src/game-module.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "snapshot": "node dist/src/write-snapshot.js"
  },
  "dependencies": {
    "@kinetra/animation": "workspace:*",
    "@kinetra/asset-pipeline": "workspace:*",
    "@kinetra/audio": "workspace:*",
    "@kinetra/command-bus": "workspace:*",
    "@kinetra/core": "workspace:*",
    "@kinetra/project-model": "workspace:*",
    "@kinetra/verification": "workspace:*"
  },
  "devDependencies": {
    "@kinetra/input": "workspace:*",
    "@kinetra/mcp-server": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1"
  }
}
