{
  "schemaVersion": 1,
  "suite": "orb-run.hud",
  "seed": 0,
  "target": "runtime",
  "steps": [
    { "type": "runtime.start", "sceneId": "scene_12q1bczg4xp8m" },
    { "type": "assert.equal", "path": "state.hud.objective.kind", "expected": "collectOrbs" },
    { "type": "assert.equal", "path": "state.hud.objective.text", "expected": "Collect the orbs (3 left)" },
    { "type": "assert.equal", "path": "state.hud.orbs.text", "expected": "Orbs 0/3" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:20" },
    { "type": "assert.equal", "path": "state.hud.timer.urgency", "expected": "normal" },
    { "type": "assert.equal", "path": "state.hud.exit.text", "expected": "Exit locked" },
    { "type": "assert.equal", "path": "state.hud.marker.kind", "expected": "orb" },
    { "type": "assert.equal", "path": "state.hud.marker.compass", "expected": "SE" },
    { "type": "assert.near", "path": "state.hud.marker.distance", "expected": 5.66, "tolerance": 0.01 },
    { "type": "assert.equal", "path": "state.hud.marker.text", "expected": "Orb SE 5.7 m" },

    { "type": "input", "action": "player.moveRight", "phase": "hold", "durationMs": 2000 },
    { "type": "assert.equal", "path": "state.hud.orbs.text", "expected": "Orbs 1/3" },
    { "type": "assert.equal", "path": "state.hud.objective.text", "expected": "Collect the orbs (2 left)" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:18" },
    { "type": "assert.equal", "path": "state.hud.marker.compass", "expected": "SW" },

    { "type": "input", "action": "player.moveLeft", "phase": "hold", "durationMs": 1000 },
    { "type": "input", "action": "player.moveBackward", "phase": "hold", "durationMs": 1000 },
    { "type": "assert.equal", "path": "state.hud.orbs.text", "expected": "Orbs 2/3" },
    { "type": "assert.equal", "path": "state.hud.exit.text", "expected": "Exit locked" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:16" },

    { "type": "input", "action": "player.moveLeft", "phase": "hold", "durationMs": 1000 },
    { "type": "input", "action": "player.moveBackward", "phase": "hold", "durationMs": 1000 },
    { "type": "wait", "milliseconds": 100 },
    { "type": "assert.equal", "path": "state.hud.orbs.text", "expected": "Orbs 3/3" },
    { "type": "assert.equal", "path": "state.hud.orbs.complete", "expected": true },
    { "type": "assert.equal", "path": "state.hud.exit.text", "expected": "Exit open" },
    { "type": "assert.equal", "path": "state.hud.objective.kind", "expected": "reachExit" },
    { "type": "assert.equal", "path": "state.hud.marker.kind", "expected": "exit" },
    { "type": "assert.equal", "path": "state.hud.marker.compass", "expected": "E" },
    { "type": "assert.equal", "path": "state.hud.marker.text", "expected": "Exit E 8.0 m" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:14" },

    { "type": "input", "action": "player.moveRight", "phase": "hold", "durationMs": 2000 },
    { "type": "wait", "milliseconds": 100 },
    { "type": "assert.equal", "path": "state.hud.objective.kind", "expected": "won" },
    { "type": "assert.equal", "path": "state.hud.banner.kind", "expected": "won" },
    { "type": "assert.equal", "path": "state.hud.banner.title", "expected": "You win!" },
    { "type": "assert.equal", "path": "state.hud.banner.subtitle", "expected": "3/3 orbs in 7.9 s" },
    { "type": "assert.equal", "path": "state.hud.timer.urgency", "expected": "normal" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:13" },

    { "type": "wait", "milliseconds": 30000 },
    { "type": "assert.equal", "path": "state.hud.banner.kind", "expected": "won" },
    { "type": "assert.equal", "path": "state.hud.timer.text", "expected": "0:13" },
    { "type": "assert.logAbsent", "minimumLevel": "warning" },
    { "type": "runtime.stop" }
  ]
}
