{
  "name": "kinetra",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native 3D game engine built on Three.js",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:foundation": "node scripts/check-foundation.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm check:foundation && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
